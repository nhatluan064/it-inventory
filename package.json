{
  "name": "it-inventory-management",
  "version": "1.0.0",
  "private": true,
  "description": "IT Inventory Management System with Firebase",
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "chart.js": "^4.5.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "firebase": "^12.2.1",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-chartjs-2": "^5.3.0",
    "react-csv": "^2.2.2",
    "react-dom": "^19.1.1",
    "react-hot-toast": "^2.6.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "setup-env": "node scripts/setup-env.js",
    "security-audit": "npm audit --audit-level moderate",
    "security-fix": "npm audit fix --force",
    "build-production": "npm run security-audit && npm run build",
    "deploy": "npm run build-production && firebase deploy",
    "clean": "rimraf build node_modules/.cache",
    "analyze": "npm run build && npx webpack-bundle-analyzer build/static/js/*.js",
    "build-analyze": "npm run build && npm run analyze",
    "prestart": "node -e \"if(!require('fs').existsSync('.env')){console.log('⚠️  .env file not found. Run: npm run setup-env');process.exit(1);}\"",
    "prebuild": "npm run prestart"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "no-console": [
        "warn",
        {
          "allow": [
            "warn",
            "error"
          ]
        }
      ],
      "no-debugger": "error",
      "no-alert": "error",
      "no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^_"
        }
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
